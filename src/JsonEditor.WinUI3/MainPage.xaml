<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JsonEditor_WinUI3.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:JsonEditor_WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open" Click="OpenButton_Click" />
            <Button Content="Save" Click="SaveButton_Click" />
            <Button Content="Validate" Click="ValidateButton_Click" />
        </StackPanel>

        <TextBox
            x:Name="EditorTextBox"
            Grid.Row="1"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            FontSize="14"
            PlaceholderText="Paste or open JSON text here" />

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="2"
            Text="Ready" />
    </Grid>
</Page>
